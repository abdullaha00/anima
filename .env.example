# Synthetic Anima simulator access
SIM_ORIGIN=https://sim.animahealth.com
SIM_KEY=

# Pi uses standard provider credentials. If no model is explicitly selected,
# it uses the model/defaults configured for Pi and available credentials.
OPENAI_API_KEY=
# Optional SDK override, e.g. openai/gpt-5.6-sol with low thinking.
CAIRN_MODEL=
CAIRN_THINKING=

# Required outside development for the Stage 2 HTTP endpoints.
CAIRN_TRIGGER_TOKEN=
CAIRN_TRIGGER_RATE_LIMIT=30
CAIRN_QUEUE_CAPACITY=100

# Durable storage. Keep this on persistent disk shared by Next.js and the worker.
CAIRN_DATA_DIR=.cairn
CAIRN_WORKER_POLL_MS=1000
CAIRN_AGENT_TIMEOUT_MS=1200000
