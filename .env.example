# Synthetic Anima simulator access
SIM_ORIGIN=https://sim.animahealth.com
SIM_KEY=

# Pi uses standard provider credentials. If no model is explicitly selected,
# it uses the model/defaults configured for Pi and available credentials.
OPENAI_API_KEY=
# Optional SDK override, e.g. openai/gpt-5.6-sol with low thinking.
CAIRN_MODEL=openai/gpt-5.6-sol
CAIRN_THINKING=low

# Stage 1 overrides; prompts, feature definitions and other limits are in
# config/stage1/default.json. Model defaults to openai/gpt-5.6-sol with low reasoning.
CAIRN_STAGE1_MODEL=
CAIRN_STAGE1_REASONING=

# Required for Stage 1 and Stage 2 HTTP endpoints in every environment.
CAIRN_TRIGGER_TOKEN=
CAIRN_TRIGGER_RATE_LIMIT=30
CAIRN_QUEUE_CAPACITY=100

# Durable storage. Keep this on persistent disk shared by Next.js and the worker.
CAIRN_DATA_DIR=.cairn
CAIRN_WORKER_POLL_MS=1000
CAIRN_AGENT_TIMEOUT_MS=1200000

# Full-record screening currently supports llm_record; no trained ML artifact is installed.
STAGE1_ENGINE=llm_record

# Explicit opt-in for the local fictional demo's screening/clinician server actions.
# Uses the existing demo clinician identity; not a production login/role system.
CAIRN_DEMO_ACTIONS=false
